# ==========================================
# SERVER CONFIGURATION
# ==========================================
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5000

# ==========================================
# DATABASE CONFIGURATION (PostgreSQL)
# ==========================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=auth_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password
# Optional connection string URL (if using remote like Supabase/Neon/Render):
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/auth_db

# ==========================================
# JWT CONFIGURATION
# ==========================================
JWT_ACCESS_SECRET=your_super_secret_access_token_key_change_in_production_12345
JWT_ACCESS_EXPIRES_IN=15m

JWT_REFRESH_SECRET=your_super_secret_refresh_token_key_change_in_production_67890
JWT_REFRESH_EXPIRES_IN=7d

JWT_TEMP_SECRET=your_temp_2fa_token_secret_key_change_in_production_abcde
JWT_TEMP_EXPIRES_IN=5m

# ==========================================
# COOKIE CONFIGURATION
# ==========================================
COOKIE_SECRET=your_cookie_signing_secret_key_change_me
COOKIE_SECURE=false # Set to true in production (HTTPS)

# ==========================================
# SMTP / EMAIL CONFIGURATION (Nodemailer)
# ==========================================
# Jika dikosongkan, token verifikasi & reset password akan dicetak ke terminal console (Simulasi)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="Sistem Autentikasi <noreply@yourdomain.com>"
